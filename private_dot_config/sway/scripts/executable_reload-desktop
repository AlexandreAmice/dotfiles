#!/usr/bin/env bash
set -euo pipefail

swaymsg reload >/dev/null
systemctl --user daemon-reload
systemctl --user restart \
    waybar.service \
    swaync.service \
    sway-idle.service \
    sway-display-layouts.service

notify-send 'Sway reloaded' 'Window manager, outputs, bar, notifications, and idle policy are using the latest configuration.'
